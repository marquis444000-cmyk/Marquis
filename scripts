--------------------------------------------------
-- ESP
--------------------------------------------------

local function clearESP(player)

	if highlights[player] then
		highlights[player]:Destroy()
		highlights[player] = nil
	end

end

local function updateESP(player)

	clearESP(player)

	if not esp or player == plr then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "MarquisESP"
	highlight.Adornee = character
	highlight.FillTransparency = .5
	highlight.OutlineTransparency = 0

	highlight.DepthMode =
		xray
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded

	highlight.Parent = character

	highlights[player] = highlight

end

local function updateAllESP()

	for _,player in ipairs(Players:GetPlayers()) do
		updateESP(player)
	end

end

espBtn.MouseButton1Click:Connect(function()

	esp = not esp

	espBtn.Text = "ESP: "..(esp and "ON" or "OFF")

	updateAllESP()

end)

xrayBtn.MouseButton1Click:Connect(function()

	xray = not xray

	xrayBtn.Text = "X-Ray: "..(xray and "ON" or "OFF")

	updateAllESP()

end)

--------------------------------------------------
-- AIM LOCK TARGET
--------------------------------------------------

local function getClosestTarget()

	local camera = workspace.CurrentCamera

	if not camera then
		return nil
	end

	local screenCenter = Vector2.new(
		camera.ViewportSize.X / 2,
		camera.ViewportSize.Y / 2
	)

	local closestPlayer = nil
	local closestDistance = math.huge

	for _,player in ipairs(Players:GetPlayers()) do

		if player ~= plr
			and player.Character then

			local humanoid =
				player.Character:FindFirstChildOfClass("Humanoid")

			local head =
				player.Character:FindFirstChild("Head")

			if humanoid
				and humanoid.Health > 0
				and head then

				local screenPosition, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible and screenPosition.Z > 0 then

					local distance =
						(
							Vector2.new(
								screenPosition.X,
								screenPosition.Y
							) - screenCenter
						).Magnitude

					if distance < closestDistance then

						closestDistance = distance
						closestPlayer = player

					end

				end

			end

		end

	end

	return closestPlayer
end

--------------------------------------------------
-- AIM LOCK
--------------------------------------------------

lockBtn.MouseButton1Click:Connect(function()

	lockOn = not lockOn

	lockBtn.Text =
		"Aim Lock: "..(lockOn and "ON" or "OFF")

	if not lockOn then
		target = nil
	end

end)

RunService:BindToRenderStep(
	"MarquisAimLock",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not lockOn then
			return
		end

		-- Continuously choose the player
		-- closest to the crosshair
		target = getClosestTarget()

		if not target then
			return
		end

		local character = target.Character

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		local head =
			character:FindFirstChild("Head")

		if not humanoid
			or humanoid.Health <= 0
			or not head then

			target = nil
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		camera.CFrame = CFrame.lookAt(
			camera.CFrame.Position,
			head.Position
		)

	end
)

--------------------------------------------------
-- GET DROPPED GUN
--------------------------------------------------

gunBtn.MouseButton1Click:Connect(function()

	local gun =
		workspace:FindFirstChild("GunDrop",true)

	if not gun then

		gunBtn.Text = "Gun Not Dropped"

		task.delay(1.5,function()
			gunBtn.Text = "Get Dropped Gun"
		end)

		return
	end

	local character = plr.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local gunPart

	if gun:IsA("BasePart") then

		gunPart = gun

	else

		gunPart =
			gun:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

	if gunPart then

		root.CFrame =
			gunPart.CFrame + Vector3.new(0,3,0)

		gunBtn.Text = "Gun Found"

		task.delay(1.5,function()
			gunBtn.Text = "Get Dropped Gun"
		end)

	end

end)

--------------------------------------------------
-- DRAG MENU
--------------------------------------------------

local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = menu.Position

	end

end)

UIS.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta =
			input.Position - dragStart

		menu.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)

		toggle.Position = UDim2.new(
			menu.Position.X.Scale,
			menu.Position.X.Offset + 240,
			menu.Position.Y.Scale,
			menu.Position.Y.Offset
		)

	end

end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = false

	end

end)

